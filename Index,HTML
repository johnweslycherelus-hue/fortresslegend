/* DAILY STREAK */
const STREAK_REWARDS = ['🧪 Potion','🧪 2× Potion','⚔️ Gear Fragment','💎 Rare Rune','🔑 Dungeon Key','✨ XP Boost +50%','💰 +150 $FLG'];

function initStreak(){
  const today = new Date().toDateString();
  const yesterday = new Date(Date.now() - 86400000).toDateString();
  let data;
  try {
    data = JSON.parse(localStorage.getItem('fl_streak') || '{"count":0,"last":"","claimed":false}');
  } catch(e){ data = {count:0, last:'', claimed:false}; }
  if(data.last === today){ renderStreak(data); return data; }
  data.count = data.last === yesterday ? Math.min(data.count + 1, 7) : 1;
  data.claimed = false;
  data.last = today;
  try { localStorage.setItem('fl_streak', JSON.stringify(data)); } catch(e){}
  renderStreak(data);
  return data;
}

function renderStreak(data){
  const dots = document.getElementById('streakDots');
  const reward = document.getElementById('streakReward');
  if(!dots || !reward) return;
  dots.innerHTML = Array.from({length:7}, (_, i) => {
    const on = i < data.count;
    return '<div style="width:18px;height:18px;border-radius:50%;background:' +
      (on ? 'var(--gold)' : 'rgba(201,162,42,.15)') +
      ';border:1px solid ' + (on ? 'var(--gold)' : 'rgba(201,162,42,.3)') +
      ';display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--dark);">' +
      (on ? '✓' : '') + '</div>';
  }).join('');
  reward.textContent = data.claimed ? '✓ Claimed' : 'Day ' + data.count + ': ' + STREAK_REWARDS[data.count-1] + ' — click to claim';
  reward.style.cursor = data.claimed ? 'default' : 'pointer';
  if(!data.claimed){
    reward.onclick = () => {
      data.claimed = true;
      try { localStorage.setItem('fl_streak', JSON.stringify(data)); } catch(e){}
      const r = STREAK_REWARDS[data.count - 1];
      if(r.indexOf('FLG') !== -1) saveFLG(flg + 150);
      showEvent('streak', '🎁 Day ' + data.count + ' Reward Claimed: ' + r + '!', null);
      renderStreak(data);
    };
  }
}

/* IDLE REPORT */
function checkIdleReport(){
  let lastSeen = 0;
  try { lastSeen = parseInt(localStorage.getItem('fl_last_seen') || '0'); } catch(e){}
  const now = Date.now();
  const mins = Math.floor((now - lastSeen) / 60000);
  try { localStorage.setItem('fl_last_seen', String(now)); } catch(e){}
  if(lastSeen === 0 || mins < 2) return;
  const hrs = Math.floor(mins / 60);
  const minions = vrf(12, 180);
  const hpLost = vrf(1, 15);
  const loot = vrf(20, 200);
  const report = document.getElementById('idleReport');
  const text = document.getElementById('idleText');
  if(!report || !text) return;
  const timeStr = hrs > 0 ? hrs + 'h ' + (mins % 60) + 'm' : mins + 'm';
  text.innerHTML =
    '<span style="color:var(--red)">⚔ ' + minions + ' Shadow Legion minions attacked your fortress</span><br>' +
    '<span style="color:var(--muted)">Auto-defenses held — fortress took <span style="color:var(--red)">' + hpLost + '% HP damage</span></span><br>' +
    '<span style="color:var(--gold)">💰 Passive income: <strong>+' + loot + ' $FLG</strong> over ' + timeStr + '</span>';
  report.style.display = 'block';
  saveFLG(flg + loot);
}

/* RANDOM EVENTS */
function triggerRandomEvent(){
  if(!selDungeon) return;
  const roll = rollD20();
  if(roll >= 18){
    const items = [
      {name:'Elixir of Power', desc:'+20% ATK', cost:30, effect:'atk'},
      {name:'Shadow Cloak', desc:'Dodge next hit', cost:45, effect:'dodge'},
      {name:'Blood Rune', desc:'Bleed enemy 3 turns', cost:25, effect:'bleed'}
    ];
    const item = items[vrf(0, 2)];
    showEvent('merchant',
      '🧙 Wandering merchant appears!<br><span style="color:var(--gold)">"' + item.name + '" (' + item.cost + ' $FLG) — ' + item.desc + '</span>',
      [
        {label:'BUY', action:() => {
          if(flg < item.cost){ addLog('❌ Not enough $FLG!', '#C0392B'); hideEvent(); return; }
          saveFLG(flg - item.cost);
          if(item.effect === 'bleed') combat.bleed += 3;
          if(item.effect === 'dodge') combat.shield = true;
          addLog('🛍️ Purchased ' + item.name + '!', '#C9A22A');
          updateEffects(); hideEvent();
        }},
        {label:'IGNORE', action:hideEvent}
      ]
    );
  } else if(roll >= 15){
    const dmg = vrf(8, 20);
    addLog('⚠️ TRAP! Spike pit deals ' + dmg + ' damage!', '#C0392B');
    takeDamage('hero', dmg);
    hideEvent();
  } else if(roll >= 12){
    const bonus = vrf(50, 150);
    showEvent('treasure',
      '💎 Hidden cache discovered!<br><span style="color:var(--gold)">+' + bonus + ' $FLG bonus!</span>',
      [{label:'CLAIM', action:() => {
        saveFLG(flg + bonus);
        addLog('💎 Cache claimed: +' + bonus + ' $FLG!', '#C9A22A');
        hideEvent();
      }}]
    );
  }
}

function showEvent(type, html, buttons){
  const panel = document.getElementById('eventPanel');
  const content = document.getElementById('eventContent');
  if(!panel || !content) return;
  const colors = {merchant:'rgba(201,162,42,.2)', treasure:'rgba(26,154,107,.15)', streak:'rgba(123,47,190,.2)', trap:'rgba(192,57,43,.15)'};
  const borders = {merchant:'var(--gold)', treasure:'var(--green)', streak:'var(--purple-text)', trap:'var(--red)'};
  panel.style.background = colors[type] || 'rgba(123,47,190,.15)';
  panel.style.borderColor = borders[type] || 'var(--purple-text)';
  let btns = '';
  if(buttons){
    btns = '<div style="display:flex;gap:8px;margin-top:10px;">' +
      buttons.map((b, i) =>
        '<button data-evbtn="' + i + '" style="padding:6px 16px;font-family:\'Cinzel\',serif;font-size:10px;font-weight:700;border-radius:4px;cursor:pointer;background:' +
        (i === 0 ? 'rgba(201,162,42,.2)' : 'rgba(255,255,255,.05)') + ';border:1px solid ' +
        (i === 0 ? 'var(--gold)' : '#333') + ';color:' + (i === 0 ? 'var(--gold)' : 'var(--muted)') + '">' +
        b.label + '</button>'
      ).join('') + '</div>';
  }
  content.innerHTML = '<div style="font-size:13px;color:var(--text);line-height:1.6;">' + html + '</div>' + btns;
  panel.style.display = 'block';
  window._eventBtns = buttons;
  content.querySelectorAll('[data-evbtn]').forEach(btn => {
    btn.addEventListener('click', () => {
      const i = parseInt(btn.getAttribute('data-evbtn'));
      if(window._eventBtns && window._eventBtns[i]) window._eventBtns[i].action();
    });
  });
}

function hideEvent(){
  const p = document.getElementById('eventPanel');
  if(p) p.style.display = 'none';
}

