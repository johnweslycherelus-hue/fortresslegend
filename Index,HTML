/* MINT */
function buildMintArea(){
  const a = document.getElementById('mintArea');
  if(!a) return;
  const minted = mintedHero && mintedHero.id === selClass.id;
  const canMint = flg >= selClass.cost && !minted;
  a.innerHTML =
    '<div style="display:flex;gap:10px;align-items:center">' +
    '<button id="mintBtn" style="flex:1;padding:12px;font-family:\'Cinzel\',serif;font-size:12px;letter-spacing:.08em;border-radius:8px;cursor:' + (canMint ? 'pointer' : 'not-allowed') + ';border:1px solid ' + (canMint ? selClass.color : minted ? 'var(--green)' : '#333') + ';background:' + (canMint ? selClass.color + '22' : minted ? 'rgba(26,154,107,.2)' : '#1a1a2a') + ';color:' + (canMint ? selClass.color : minted ? 'var(--green)' : '#555') + ';transition:all .2s;">' +
    (minted ? '✓ HERO MINTED' : 'MINT · ' + selClass.cost + ' $FLG') + '</button>' +
    (mintedHero ? '<div style="font-size:10px;color:var(--red);font-family:monospace;text-align:center"><div>BURNED</div><div>' + mintedHero.cost + ' $FLG</div></div>' : '') +
    '</div>';
  const btn = document.getElementById('mintBtn');
  if(btn) btn.addEventListener('click', doMint);
}

function doMint(){
  if(flg < selClass.cost || (mintedHero && mintedHero.id === selClass.id)) return;
  saveFLG(flg - selClass.cost);
  mintedHero = {id:selClass.id, name:selClass.name, cost:selClass.cost, icon:selClass.icon};
  buildMintArea();
  buildEnterBtn();
  hudVals.heroes++;
}

