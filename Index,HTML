function startCombat(){
  const d = selDungeon;
  combat = {
    running:true, active:true,
    heroHP:selClass.maxHP, heroMaxHP:selClass.maxHP,
    enemyHP:d.enemyHP, enemyMaxHP:d.enemyHP,
    turn:0, lavaTimer:d.id === 'crypt' ? 99 : 3,
    ultimateUsed:false, bleed:0, shield:false, deathMark:false,
    enemyName:d.enemyName, enemyAtk:d.enemyAtk
  };
  updateHPBars(); updateEffects();
  document.getElementById('combatActions').style.display = 'block';
  document.getElementById('enterBtn').style.display = 'none';
  document.getElementById('abilityDesc').textContent = selClass.desc;
  setActionBtnsEnabled(true);
  setTimeout(() => { if(vrf(1, 10) > 6) triggerRandomEvent(); }, 1200);
}

function doAction(type){
  if(!combat.active) return;
  setActionBtnsEnabled(false);
  const d20 = rollD20();
  let heroAtk = Math.floor(selClass.stats.STR / 10) + rollDice(2, 8);
  if(combat.deathMark) heroAtk = Math.floor(heroAtk * 2);
  const syn = getActiveSynergy();
  if(syn && syn.classes.indexOf('rogue') !== -1 && selClass.id === 'rogue') heroAtk = Math.floor(heroAtk * 1.4);
  combat.turn++;

  if(type === 'attack'){
    const dmg = heroAtk + rollDice(1, 6);
    addLog('⚔️ [Turn ' + combat.turn + '] ' + selClass.name + ' attacks — ' + dmg + ' damage!', '#aaaacc');
    applyDamage('enemy', dmg);
    if(combat.bleed > 0){
      const bd = vrf(4, 10);
      addLog('🩸 Bleed: ' + bd + ' damage (' + combat.bleed + ' turns left)', '#C0392B');
      applyDamage('enemy', bd);
      combat.bleed--;
      updateEffects();
    }
  } else if(type === 'overcharge'){
    addLog('⚡ [Turn ' + combat.turn + '] OVERCHARGE — Rolling d20 for control...', '#C9A22A');
    setTimeout(() => {
      addLog('🎲 d20 rolled: ' + d20 + ' (need ≥ 10)', '#8A7AAA');
      if(d20 >= 10){
        const dmg = heroAtk * 2 + rollDice(2, 10);
        addLog('💥 OVERCHARGE HIT! ' + dmg + ' CRUSHING damage!', '#C9A22A');
        document.getElementById('logBox').classList.add('crit-flash');
        setTimeout(() => document.getElementById('logBox').classList.remove('crit-flash'), 400);
        applyDamage('enemy', dmg);
        if(d20 >= 18){
          addLog('✨ CRITICAL! Stole enemy buff!', '#C9A22A');
          combat.bleed = Math.max(combat.bleed, 2);
          updateEffects();
        }
      } else {
        if(d20 === 9){
          const missed = heroAtk * 2 + 16;
          addLog('😤 NEAR MISS! d20=' + d20 + ' — missed by 1! Would have dealt ' + missed + '!', '#C0392B');
          document.getElementById('logBox').classList.add('near-miss-flash');
          setTimeout(() => document.getElementById('logBox').classList.remove('near-miss-flash'), 800);
        } else {
          addLog('❌ BACKLASH! d20=' + d20 + ' — loss of control!', '#C0392B');
        }
        const backlash = rollDice(1, 8) + 5;
        addLog('💥 Backlash: ' + selClass.name + ' takes ' + backlash + ' self-damage!', '#C0392B');
        document.getElementById('combatActions').classList.add('shake');
        setTimeout(() => document.getElementById('combatActions').classList.remove('shake'), 400);
        takeDamage('hero', backlash);
      }
      enemyTurn();
    }, 700);
    return;
  } else if(type === 'defend'){
    const fd = vrf(8, 15);
    const aoe = Math.floor(combat.heroMaxHP * 0.35) + rollDice(3, 8);
    takeDamage('hero', fd);
    addLog('🏰 [Turn ' + combat.turn + '] Sacrificed fortress wing — ' + fd + ' HP lost!', '#2980B9');
    addLog('💥 AOE COUNTER-ATTACK: ' + aoe + ' damage to all enemies!', '#2980B9');
    applyDamage('enemy', aoe);
    combat.shield = true;
    updateEffects();
    addLog('🛡️ Defensive stance — next hit absorbed!', '#2980B9');
  } else if(type === 'ability'){
    if(combat.ultimateUsed){
      addLog('⚠️ Ultimate already used this dungeon!', '#8A7AAA');
      setActionBtnsEnabled(true);
      return;
    }
    combat.ultimateUsed = true;
    if(selClass.id === 'warrior'){
      const dmg = heroAtk * 3;
      addLog('⚔️ CHAMPIONS WRATH! ' + dmg + ' devastating damage!', '#C0392B');
      applyDamage('enemy', dmg);
      const heal = Math.floor(combat.heroMaxHP * 0.3);
      combat.heroHP = Math.min(combat.heroMaxHP, combat.heroHP + heal);
      addLog('💚 Battle fury heals ' + heal + ' HP!', '#1A9A6B');
      updateHPBars();
    } else if(selClass.id === 'mage'){
      const dmg = rollDice(20, 10) + 40;
      addLog('🔮 RIFT EXPLOSION! ' + dmg + ' void damage!', '#8E44AD');
      applyDamage('enemy', dmg);
    } else if(selClass.id === 'rogue'){
      combat.deathMark = true;
      addLog('🗡️ DEATH MARK — +100% damage for 5 turns!', '#1A8A6B');
      updateEffects();
    } else if(selClass.id === 'healer'){
      combat.heroHP = combat.heroMaxHP;
      combat.bleed = 0;
      combat.shield = false;
      addLog('✨ DIVINE MIRACLE — Full HP restored! All conditions cured!', '#C9A22A');
      updateHPBars();
      updateEffects();
    }
    const line = selClass.voice[vrf(0, 2)];
    addLog('💬 "' + line + '"', 'rgba(255,255,255,.3)');
  }

  if(selDungeon && selDungeon.id !== 'crypt'){
    combat.lavaTimer--;
    if(combat.lavaTimer <= 0){
      const ld = vrf(15, 30);
      addLog('🌋 LAVA SURGE! ' + ld + ' environmental damage!', '#FF6B35');
      takeDamage('hero', ld);
      combat.lavaTimer = 3;
    } else if(combat.lavaTimer === 1){
      addLog('🌋 WARNING: Lava rises in 1 turn!', '#FF6B35');
    }
  }
  enemyTurn();
}

function enemyTurn(){
  if(!combat.active) return;
  setTimeout(() => {
    let atkDmg = Math.floor(combat.enemyAtk * (0.7 + Math.random() * 0.6));
    if(combat.shield){
      addLog('🛡️ Enemy attack absorbed by shield!', '#2980B9');
      combat.shield = false;
      updateEffects();
    } else {
      addLog('👿 ' + combat.enemyName + ' attacks — ' + atkDmg + ' damage!', '#C0392B');
      takeDamage('hero', atkDmg);
    }
    if(combat.enemyHP <= 0){ endCombat(true); return; }
    if(combat.heroHP <= 0){ endCombat(false); return; }
    if(combat.turn % 3 === 0 && vrf(1, 10) > 7) triggerRandomEvent();
    setActionBtnsEnabled(true);
  }, 900);
}

function applyDamage(target, dmg){
  if(target === 'enemy'){
    combat.enemyHP = Math.max(0, combat.enemyHP - dmg);
    if(combat.enemyHP <= 0){ endCombat(true); return; }
  }
  updateHPBars();
}

function takeDamage(target, dmg){
  if(target === 'hero'){
    combat.heroHP = Math.max(0, combat.heroHP - dmg);
    if(combat.heroHP <= 0){ endCombat(false); return; }
  }
  updateHPBars();
}

function updateHPBars(){
  const hpEl = document.getElementById('heroHP');
  const hpBar = document.getElementById('heroHPBar');
  const eEl = document.getElementById('enemyHP');
  const eBar = document.getElementById('enemyHPBar');
  if(!hpEl) return;
  hpEl.textContent = combat.heroHP + '/' + combat.heroMaxHP;
  hpBar.style.width = ((combat.heroHP / combat.heroMaxHP) * 100) + '%';
  hpBar.style.background = combat.heroHP < combat.heroMaxHP * 0.3 ?
    'linear-gradient(90deg,#8B0000,#C0392B)' : 'linear-gradient(90deg,#1A9A6B,#2ECC71)';
  if(combat.enemyHP > 0){
    eEl.textContent = combat.enemyHP + '/' + combat.enemyMaxHP;
    eBar.style.width = ((combat.enemyHP / combat.enemyMaxHP) * 100) + '%';
  } else {
    eEl.textContent = 'DEFEATED';
    eBar.style.width = '0%';
  }
}

function updateEffects(){
  const el = document.getElementById('activeEffects');
  if(!el) return;
  const eff = [];
  if(combat.bleed > 0) eff.push('<span class="bleed-badge" style="font-size:10px;padding:2px 8px;background:rgba(192,57,43,.2);border:1px solid var(--red);border-radius:10px;font-family:monospace;">🩸 BLEED ×' + combat.bleed + '</span>');
  if(combat.shield) eff.push('<span style="font-size:10px;padding:2px 8px;background:rgba(41,128,185,.2);border:1px solid #2980B9;border-radius:10px;font-family:monospace;">🛡️ SHIELD</span>');
  if(combat.deathMark) eff.push('<span style="font-size:10px;padding:2px 8px;background:rgba(26,138,107,.2);border:1px solid #1A8A6B;border-radius:10px;font-family:monospace;">💀 DEATH MARK</span>');
  if(combat.ultimateUsed) eff.push('<span style="font-size:10px;padding:2px 8px;background:rgba(123,47,190,.2);border:1px solid var(--purple-text);border-radius:10px;font-family:monospace;">⚡ ULT USED</span>');
  if(selDungeon && selDungeon.id !== 'crypt' && combat.lavaTimer <= 2) eff.push('<span style="font-size:10px;padding:2px 8px;background:rgba(255,107,53,.2);border:1px solid #FF6B35;border-radius:10px;font-family:monospace;">🌋 LAVA ' + combat.lavaTimer + 'T</span>');
  el.innerHTML = eff.join('');
}

function setActionBtnsEnabled(enabled){
  document.querySelectorAll('.action-btn').forEach(b => { b.disabled = !enabled; });
}

function endCombat(won){
  combat.active = false;
  setActionBtnsEnabled(false);
  const box = document.getElementById('logBox');
  if(won){
    const reward = vrf(selDungeon.min, selDungeon.max);
    const bonus = getActiveSynergy() ? Math.floor(reward * 0.15) : 0;
    saveFLG(flg + reward + bonus);
    hudVals.dungeons++;
    const fortXP = {crypt:20, void:45, abyss:80}[selDungeon.id] || 20;
    addFortXP(fortXP);
    fortLog('⚔️ Dungeon cleared — +' + fortXP + ' Fortress XP earned', '#9B5FDE');
    const res = document.createElement('div');
    res.className = 'log-result';
    res.innerHTML =
      '<div style="color:var(--green);font-size:14px;font-family:\'Cinzel\',serif;font-weight:700;">🏆 VICTORY!</div>' +
      '<div style="color:var(--gold);margin-top:6px;">+' + reward.toLocaleString() + ' $FLG' +
      (bonus ? ' <span style="color:var(--green)">+' + bonus + ' SYNERGY</span>' : '') + '!</div>' +
      '<button id="combatResetBtn" style="margin-top:10px;padding:8px 20px;font-family:\'Cinzel\',serif;font-size:11px;font-weight:700;border-radius:4px;cursor:pointer;background:rgba(201,162,42,.2);border:1px solid var(--gold);color:var(--gold);">ENTER AGAIN</button>';
    box.appendChild(res);
    setTimeout(() => {
      const rb = document.getElementById('combatResetBtn');
      if(rb) rb.addEventListener('click', resetCombat);
    }, 10);
  } else {
    const res = document.createElement('div');
    res.className = 'log-result';
    res.style.background = 'rgba(192,57,43,.12)';
    res.style.borderColor = 'rgba(192,57,43,.4)';
    res.innerHTML =
      '<div style="color:var(--red);font-size:14px;font-family:\'Cinzel\',serif;font-weight:700;">💀 DEFEATED</div>' +
      '<div style="color:#C0A0A0;margin-top:4px;">Your hero falls...</div>' +
      '<button id="combatResetBtn2" style="margin-top:10px;padding:8px 20px;font-family:\'Cinzel\',serif;font-size:11px;font-weight:700;border-radius:4px;cursor:pointer;background:rgba(192,57,43,.2);border:1px solid var(--red);color:var(--red);">TRY AGAIN</button>';
    box.appendChild(res);
    setTimeout(() => {
      const rb = document.getElementById('combatResetBtn2');
      if(rb) rb.addEventListener('click', resetCombat);
    }, 10);
  }
  box.scrollTop = box.scrollHeight;
  document.getElementById('combatActions').style.display = 'none';
  document.getElementById('enterBtn').style.display = 'block';
  buildEnterBtn();
}

function resetCombat(){
  combat.running = false;
  document.getElementById('combatActions').style.display = 'none';
  document.getElementById('enterBtn').style.display = 'block';
  buildEnterBtn();
}

function addLog(msg, color){
  const box = document.getElementById('logBox');
  if(!box) return;
  const line = document.createElement('div');
  line.className = 'log-line';
  line.innerHTML = '<span style="color:' + (color || '#8a8aaa') + '">' + msg + '</span>';
  box.appendChild(line);
  box.scrollTop = box.scrollHeight;
}

/* SYNERGY */
function getActiveSynergy(){
  for(const syn of SYNERGIES){
    if(syn.classes.every(c => selectedClasses.has(c))) return syn;
  }
  return null;
}

function updateSynergy(){
  const badge = document.getElementById('synergyBadge');
  const text = document.getElementById('synergyText');
  if(!badge || !text) return;
  const syn = getActiveSynergy();
  if(syn){
    badge.style.display = 'block';
    badge.style.borderColor = syn.color + '66';
    badge.style.background = syn.color + '11';
    text.innerHTML = '<span style="color:' + syn.color + ';font-family:\'Cinzel\',serif;font-weight:700">' + syn.name + '</span><br><span style="color:var(--muted);font-size:11px;">' + syn.desc + '</span>';
  } else {
    badge.style.display = 'none';
  }
}

/* CLASS GRID */
function buildClassGrid(){
  const grid = document.getElementById('classGrid');
  if(!grid) return;
  grid.innerHTML = CLASSES.map(c => {
    const sel = selectedClasses.has(c.id);
    return '<div class="class-card ' + (c.id === selClass.id ? 'selected' : '') +
      '" data-class="' + c.id + '" style="background:' + (sel ? c.color + '22' : '#0f0f1a') +
      ';border-color:' + (sel ? c.color : '#2a2a3a') + ';">' +
      '<div class="class-icon">' + c.icon + '</div>' +
      '<div class="class-name" style="color:' + (sel ? c.color : '#ccc') + '">' + c.name + '</div>' +
      '<div class="class-role">' + c.role + '</div></div>';
  }).join('');
  grid.querySelectorAll('[data-class]').forEach(el => {
    el.addEventListener('click', () => selectClass(el.getAttribute('data-class')));
  });
}

function selectClass(id){
  selClass = CLASSES.find(c => c.id === id);
  if(selectedClasses.has(id)){
    selectedClasses.delete(id);
  } else {
    if(selectedClasses.size >= 2) selectedClasses.clear();
    selectedClasses.add(id);
  }
  buildClassGrid();
  buildHeroStats();
  buildMintArea();
  updateSynergy();
}

