  const amt = parseFloat(amtEl.value) || 0;
  const price = parseFloat(priceEl.value) || 0;
  const t = TIERS[selTier];
  const apy = 24 * t.mult;
  const yFLG = amt * (apy / 100);
  const mFLG = yFLG / 12;
  const yUSD = yFLG * price;
  document.getElementById('tierInfo').textContent = 'Lock: ' + t.lock + ' · Multiplier: ' + t.mult + '× · APY: ' + apy.toFixed(1) + '%';
  document.getElementById('stakeResults').innerHTML =
    '<div style="background:rgba(201,162,42,.08);border:1px solid rgba(201,162,42,.3);border-radius:6px;padding:10px;text-align:center"><div style="font-size:15px;color:var(--gold);font-family:\'Cinzel\',serif;font-weight:700">' + Math.round(mFLG).toLocaleString() + '</div><div style="font-size:9px;color:var(--muted);font-family:monospace;margin-top:3px">MONTHLY $FLG</div></div>' +
    '<div style="background:rgba(123,47,190,.08);border:1px solid rgba(123,47,190,.3);border-radius:6px;padding:10px;text-align:center"><div style="font-size:15px;color:var(--purple-text);font-family:\'Cinzel\',serif;font-weight:700">' + Math.round(yFLG).toLocaleString() + '</div><div style="font-size:9px;color:var(--muted);font-family:monospace;margin-top:3px">YEARLY $FLG</div></div>' +
    '<div style="background:rgba(26,154,107,.08);border:1px solid rgba(26,154,107,.3);border-radius:6px;padding:10px;text-align:center"><div style="font-size:15px;color:var(--green);font-family:\'Cinzel\',serif;font-weight:700">$' + yUSD.toFixed(2) + '</div><div style="font-size:9px;color:var(--muted);font-family:monospace;margin-top:3px">YEARLY USD</div></div>';
  document.getElementById('tierDetails').innerHTML = TIERS.map(t2 =>
    '<div style="padding:14px 0;border-bottom:1px solid var(--border);display:flex;gap:12px;align-items:center"><div style="width:7px;height:7px;border-radius:50%;background:' + t2.color + ';flex-shrink:0"></div><div style="flex:1"><div style="font-size:14px;font-family:\'Cinzel\',serif;color:' + t2.color + ';font-weight:700">' + t2.name + ' Stake</div><div style="font-size:12px;color:var(--muted);font-family:\'Crimson Text\',serif;margin-top:2px">' + t2.lock + ' lock</div></div><div style="text-align:right"><div style="font-size:15px;color:' + t2.color + ';font-family:\'Cinzel\',serif;font-weight:700">' + t2.mult + '×</div><div style="font-size:9px;color:var(--muted);font-family:monospace">MULT</div></div></div>'
  ).join('');
}

