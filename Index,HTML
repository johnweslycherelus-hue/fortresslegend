/* SUPPLY CHART */
function buildSupplyChart(){
  const svg = document.getElementById('supplyChart');
  if(!svg) return;
  const W = 500, H = 180;
  const pad = {t:10, r:20, b:38, l:42};
  const cw = W - pad.l - pad.r, ch = H - pad.t - pad.b, maxV = 45;
  const xS = i => pad.l + (i / (SUPPLY.length - 1)) * cw;
  const yS = v => pad.t + ch - (v / maxV) * ch;
  const path = key => SUPPLY.map((d, i) => (i === 0 ? 'M' : 'L') + xS(i) + ',' + yS(d[key])).join(' ');
  const gridLines = [0, 10, 20, 30, 40].map(v =>
    '<line x1="' + pad.l + '" y1="' + yS(v) + '" x2="' + (W - pad.r) + '" y2="' + yS(v) + '" stroke="#ffffff08" stroke-width="1"/>' +
    '<text x="' + (pad.l - 5) + '" y="' + (yS(v) + 4) + '" text-anchor="end" font-size="9" fill="#555" font-family="monospace">' + v + 'M</text>'
  ).join('');
  const xLabels = SUPPLY.map((d, i) =>
    '<text x="' + xS(i) + '" y="' + (H - 8) + '" text-anchor="middle" font-size="9" fill="#555" font-family="monospace">' + d.m + 'mo</text>'
  ).join('');
  svg.innerHTML = gridLines + xLabels +
    '<path d="' + path('b') + '" fill="none" stroke="#C0392B88" stroke-width="1.5" stroke-dasharray="4,3"/>' +
    '<path d="' + path('a') + '" fill="none" stroke="#C9A22A" stroke-width="2.5"/>' +
    '<path d="' + path('u') + '" fill="none" stroke="#1A9A6B" stroke-width="2"/>' +
    '<text x="' + (W - pad.r - 80) + '" y="' + (pad.t + 10) + '" font-size="9" fill="#C0392B88" font-family="monospace">Bear</text>' +
    '<text x="' + (W - pad.r - 80) + '" y="' + (pad.t + 22) + '" font-size="9" fill="#C9A22A" font-family="monospace">Base</text>' +
    '<text x="' + (W - pad.r - 80) + '" y="' + (pad.t + 34) + '" font-size="9" fill="#1A9A6B" font-family="monospace">Bull</text>';
}

/* TAB SWITCHER */
function switchTab(id){
  ['combat','staking','tokenomics','fortress'].forEach(t => {
    const el = document.getElementById('tab-' + t);
    if(el) el.style.display = t === id ? 'block' : 'none';
  });
  document.querySelectorAll('.demo-tab').forEach(btn => {
    btn.classList.toggle('active', btn.getAttribute('data-tab') === id);
  });
  if(id === 'fortress') buildFortressTab();
}

/* ══════════════════════════════════════════════════════
   FORTRESS SYSTEM
   ══════════════════════════════════════════════════════ */
let fortState;
try {
  const s = JSON.parse(localStorage.getItem('fl_fortress') || '{}');
  fortState = {level:s.level || 1, xp:s.xp || 0, rooms:s.rooms || {}};
} catch(e){ fortState = {level:1, xp:0, rooms:{}}; }

function saveFortState(){
  try { localStorage.setItem('fl_fortress', JSON.stringify(fortState)); } catch(e){}
}

function addFortXP(amount){
  fortState.xp += amount;
  const lvlData = FORTRESS_LEVELS[fortState.level - 1];
  if(fortState.xp >= lvlData.xpNeeded && fortState.level < 10){
    fortState.level++;
    fortState.xp = 0;
    fortLog('🎉 FORTRESS LEVELED UP! Now Level ' + fortState.level + ': ' + FORTRESS_LEVELS[fortState.level - 1].name, 'var(--gold)');
    saveFortState();
    buildFortressTab();
    return;
  }
  saveFortState();
  buildFortressXPBar();
}

function buildFortressXPBar(){
  const lvlData = FORTRESS_LEVELS[Math.min(fortState.level - 1, 9)];
  const pct = lvlData.xpNeeded < 99999 ? (fortState.xp / lvlData.xpNeeded) * 100 : 100;
  const bar = document.getElementById('fortXPBar');
  const xpEl = document.getElementById('fortXP');
  const xpNEl = document.getElementById('fortXPNeeded');
  const lvlEl = document.getElementById('fortLevel');
  if(bar) bar.style.width = pct + '%';
  if(xpEl) xpEl.textContent = fortState.xp.toLocaleString();
  if(xpNEl) xpNEl.textContent = lvlData.xpNeeded < 99999 ? lvlData.xpNeeded.toLocaleString() : 'MAX';
  if(lvlEl) lvlEl.textContent = fortState.level;
}

function buildFortressVisual(){
  const data = FORTRESS_LEVELS[Math.min(fortState.level - 1, 9)];
  const emoji = document.getElementById('fortressEmoji');
  const name = document.getElementById('fortressName');
  const desc = document.getElementById('fortressDesc');
  const bg = document.getElementById('fortressBg');
  if(emoji) emoji.textContent = data.emoji;
  if(name) name.textContent = data.name;
  if(desc) desc.textContent = data.desc;
  if(bg) bg.style.background = 'radial-gradient(ellipse at 50% 50%, ' + data.bg + ' 0%, transparent 70%)';
  if(emoji && fortState.level >= 8){
    emoji.style.animation = 'livePulse 2s ease-in-out infinite';
    emoji.style.filter = 'drop-shadow(0 0 30px var(--gold)) drop-shadow(0 0 60px var(--purple))';
  }
}

function buildMilestones(){
  const el = document.getElementById('milestonesGrid');
  if(!el) return;
  el.innerHTML = FORTRESS_LEVELS.map(l => {
    const done = fortState.level > l.lvl;
    const current = fortState.level === l.lvl;
    const locked = fortState.level < l.lvl;
    return '<div style="display:flex;align-items:center;gap:10px;padding:6px 10px;border-radius:6px;background:' +
      (current ? 'rgba(201,162,42,.1)' : done ? 'rgba(26,154,107,.06)' : 'rgba(255,255,255,.02)') +
      ';border:1px solid ' +
      (current ? 'rgba(201,162,42,.4)' : done ? 'rgba(26,154,107,.2)' : 'rgba(255,255,255,.04)') + ';">' +
      '<span style="font-size:18px;' + (locked ? 'filter:grayscale(1);opacity:.3' : '') + '">' + l.emoji + '</span>' +
      '<div style="flex:1"><div style="font-family:\'Cinzel\',serif;font-size:11px;color:' +
      (current ? 'var(--gold)' : done ? 'var(--green)' : 'var(--muted)') +
      ';font-weight:' + (current ? 700 : 400) + ';">Lv' + l.lvl + ' — ' + l.name + '</div></div>' +
      '<span style="font-size:14px;">' + (done ? '✅' : current ? '⚡' : '🔒') + '</span></div>';
  }).join('');
}

function buildRooms(){
  const el = document.getElementById('roomsGrid');
  if(!el) return;
  el.innerHTML = SPECIAL_ROOMS.map(room => {
    const built = fortState.rooms[room.id];
    const unlocked = fortState.level >= room.unlockLvl;
    const canBuild = unlocked && !built && flg >= room.cost;
    return '<div style="background:' + (built ? 'rgba(26,154,107,.08)' : 'rgba(13,8,32,.8)') +
      ';border:1px solid ' + (built ? 'rgba(26,154,107,.4)' : unlocked ? 'var(--border)' : 'rgba(255,255,255,.04)') +
      ';border-radius:8px;padding:14px;opacity:' + (unlocked ? 1 : 0.5) + ';">' +
      '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;">' +
      '<div style="display:flex;gap:8px;align-items:center;">' +
      '<span style="font-size:22px;">' + room.emoji + '</span>' +
      '<div><div style="font-family:\'Cinzel\',serif;font-size:13px;color:' + (built ? 'var(--green)' : '#E8D8FF') + ';font-weight:700;">' + room.name + '</div>' +
      '<div style="font-family:monospace;font-size:9px;color:var(--muted);">UNLOCKS LV' + room.unlockLvl + '</div></div></div>' +
      (built ? '<span style="font-size:11px;padding:3px 10px;background:rgba(26,154,107,.2);border:1px solid var(--green);border-radius:10px;color:var(--green);font-family:monospace;">BUILT ✓</span>' :
       unlocked ? '<button data-room="' + room.id + '" style="font-size:11px;padding:4px 12px;border-radius:4px;border:1px solid ' + (canBuild ? 'var(--gold)' : '#555') + ';color:' + (canBuild ? 'var(--dark)' : '#888') + ';cursor:' + (canBuild ? 'pointer' : 'not-allowed') + ';background:' + (canBuild ? 'var(--gold)' : '#555') + ';font-family:\'Cinzel\',serif;font-weight:700;">' + room.cost + ' $FLG</button>' :
       '<span style="font-size:10px;color:var(--muted);font-family:monospace;">LV' + room.unlockLvl + ' REQ</span>') +
      '</div>' +
      '<div style="font-size:12px;color:var(--muted);font-family:\'Crimson Text\',serif;line-height:1.4;margin-bottom:6px;">' + room.desc + '</div>' +
      '<div style="font-size:10px;color:' + (built ? 'var(--green)' : 'var(--gold)') + ';font-family:monospace;">⚡ ' + room.bonus + '</div>' +
      '</div>';
  }).join('');
  el.querySelectorAll('[data-room]').forEach(btn => {
    btn.addEventListener('click', () => buildRoom(btn.getAttribute('data-room')));
  });
  buildActiveBonuses();
}

function buildActiveBonuses(){
  const el = document.getElementById('activeBonuses');
  if(!el) return;
  const active = SPECIAL_ROOMS.filter(r => fortState.rooms[r.id]);
  if(active.length === 0){
    el.innerHTML = '<div style="font-size:11px;color:var(--muted);font-family:monospace;">No rooms built yet — build rooms to unlock bonuses</div>';
    return;
  }
  el.innerHTML = active.map(r =>
    '<div style="display:flex;align-items:center;gap:8px;"><span>' + r.emoji + '</span><span style="font-size:11px;color:var(--green);font-family:monospace;">' + r.bonus + '</span></div>'
  ).join('');
}

function buildRoom(roomId){
  const room = SPECIAL_ROOMS.find(r => r.id === roomId);
  if(!room || fortState.rooms[roomId] || flg < room.cost) return;
  saveFLG(flg - room.cost);
  fortState.rooms[roomId] = true;
  saveFortState();
  addFortXP(50);
  fortLog('🏗️ ' + room.name + ' constructed! ' + room.bonus, 'var(--gold)');
  buildRooms();
  hudVals.burned += room.cost;
}

function upgradeFortress(){
  const lvlData = FORTRESS_LEVELS[Math.min(fortState.level - 1, 8)];
  if(fortState.level >= 10){ fortLog('🏆 Maximum fortress level reached!', 'var(--gold)'); return; }
  if(flg < lvlData.upgradeCost){ fortLog('❌ Need ' + lvlData.upgradeCost + ' $FLG to upgrade', 'var(--red)'); return; }
  saveFLG(flg - lvlData.upgradeCost);
  addFortXP(lvlData.xpNeeded - fortState.xp + 1);
  fortLog('⬆️ Fortress upgraded! Spent ' + lvlData.upgradeCost + ' $FLG', 'var(--purple-text)');
  hudVals.burned += lvlData.upgradeCost;
}

function trainHero(){
  if(!mintedHero){ fortLog('❌ Mint a hero first in the Combat tab!', 'var(--red)'); return; }
  const cost = 30;
  if(flg < cost){ fortLog('❌ Need 30 $FLG for training session', 'var(--red)'); return; }
  saveFLG(flg - cost);
  const xpGained = fortState.rooms['training'] ? 35 : 25;
  addFortXP(xpGained);
  fortLog('⚔️ ' + mintedHero.name + ' completed training — +' + xpGained + ' Fortress XP', '#9B5FDE');
  hudVals.burned += cost;
}

function updateUpgradeBtn(){
  const btn = document.getElementById('upgradeBtn');
  const info = document.getElementById('upgradeInfo');
  if(!btn) return;
  if(fortState.level >= 10){
    btn.textContent = '🏆 MAX LEVEL';
    btn.disabled = true;
    if(info) info.textContent = 'Eternal Citadel — pinnacle of Eldoria';
    return;
  }
  const lvlData = FORTRESS_LEVELS[fortState.level - 1];
  const nextData = FORTRESS_LEVELS[fortState.level];
  const canUpgrade = flg >= lvlData.upgradeCost;
  btn.disabled = !canUpgrade || lvlData.upgradeCost === 0;
  if(info) info.textContent = lvlData.upgradeCost > 0 ?
    'Cost: ' + lvlData.upgradeCost + ' $FLG → ' + nextData.name :
    'Earn XP by training and raiding dungeons';
}

function fortLog(msg, color){
  const box = document.getElementById('fortressLog');
  if(!box) return;
  const line = document.createElement('div');
  line.style.color = color || '#8a8aaa';
  line.style.marginBottom = '2px';
  line.textContent = msg;
  const placeholder = box.querySelector('div[style*="text-align:center"]');
  if(placeholder) box.innerHTML = '';
  box.appendChild(line);
  box.scrollTop = box.scrollHeight;
}

function buildFortressTab(){
  buildFortressVisual();
  buildFortressXPBar();
  buildMilestones();
  buildRooms();
  updateUpgradeBtn();
}

/* ══════════════════════════════════════════════════════
   EVENT LISTENERS & INIT
   ══════════════════════════════════════════════════════ */

// Tab buttons
document.querySelectorAll('.demo-tab').forEach(btn => {
  btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
});

// Combat action buttons
document.querySelectorAll('[data-action]').forEach(btn => {
  btn.addEventListener('click', () => doAction(btn.getAttribute('data-action')));
});

// Enter dungeon button
const enterBtnEl = document.getElementById('enterBtn');
if(enterBtnEl) enterBtnEl.addEventListener('click', enterDungeon);

// Upgrade/train buttons
const upBtn = document.getElementById('upgradeBtn');
if(upBtn) upBtn.addEventListener('click', upgradeFortress);
const trBtn = document.getElementById('trainBtn');
if(trBtn) trBtn.addEventListener('click', trainHero);

// Staking inputs
const stakeAmt = document.getElementById('stakeAmount');
if(stakeAmt) stakeAmt.addEventListener('input', calcStake);
const stakePrc = document.getElementById('stakePrice');
if(stakePrc) stakePrc.addEventListener('input', calcStake);

/* ECONOMY HUD */
var hudVals = {burned:42183, heroes:1204, dungeons:8991, price:0.100};
setInterval(() => {
  hudVals.burned += Math.floor(Math.random() * 12 + 3);
  if(Math.random() > 0.92) hudVals.heroes++;
  if(Math.random() > 0.85) hudVals.dungeons++;
  hudVals.price = Math.max(0.001, hudVals.price + (Math.random() * 0.002 - 0.001));
  const b = document.getElementById('hud-burned');
  const h = document.getElementById('hud-heroes');
  const d = document.getElementById('hud-dungeons');
  const p = document.getElementById('hud-price');
  if(b) b.textContent = hudVals.burned.toLocaleString();
  if(h) h.textContent = hudVals.heroes.toLocaleString();
  if(d) d.textContent = hudVals.dungeons.toLocaleString();
  if(p) p.textContent = '$' + hudVals.price.toFixed(3);
}, 3000);

/* BOOT */
buildClassGrid();
buildHeroStats();
buildMintArea();
buildDungeons();
buildEnterBtn();
buildTierBtns();
calcStake();
buildAllocList();
buildSupplyChart();
initStreak();
checkIdleReport();
updateSynergy();
</script>

