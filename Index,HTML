  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, pts = [];
  function resize(){ W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
  function initPts(){
    pts = Array.from({length:70}, () => ({
      x: Math.random()*W, y: Math.random()*H,
      vx: (Math.random()-.5)*.22, vy: -Math.random()*.38-.07,
      r: Math.random()*1.7+.4, o: Math.random()*.4+.05,
      c: Math.random()>.55 ? '#C9A22A' : '#7B2FBE'
    }));
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    pts.forEach(p => {
      p.x += p.vx; p.y += p.vy;
      if(p.y < -10){ p.y = H+10; p.x = Math.random()*W; }
      if(p.x < -10) p.x = W+10;
      if(p.x > W+10) p.x = -10;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
      ctx.fillStyle = p.c + Math.floor(p.o*255).toString(16).padStart(2,'0');
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize', () => { resize(); initPts(); });
  resize(); initPts(); draw();
})();

