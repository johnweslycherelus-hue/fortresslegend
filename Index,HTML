/* RNG */
function vrf(min, max){ return min + Math.floor(Math.random() * (max - min + 1)); }
function rollD20(){ return vrf(1, 20); }
function rollDice(n, sides){ let t = 0; for(let i = 0; i < n; i++) t += vrf(1, sides); return t; }

