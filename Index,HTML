/* ENTER BUTTON */
function buildEnterBtn(){
  const btn = document.getElementById('enterBtn');
  if(!btn) return;
  const dis = !mintedHero || !selDungeon || combat.running;
  const label = !mintedHero ? 'MINT A HERO FIRST' :
                !selDungeon ? 'SELECT A DUNGEON' :
                '⚔ ENTER ' + selDungeon.name.toUpperCase();
  btn.textContent = label;
  btn.style.background = dis ? '#1a1a2a' : 'linear-gradient(135deg,var(--purple),#4a1280)';
  btn.style.color = dis ? '#555' : '#fff';
  btn.style.border = '1px solid ' + (dis ? '#333' : 'var(--purple)');
  btn.style.cursor = dis ? 'not-allowed' : 'pointer';
  btn.style.boxShadow = dis ? 'none' : '0 0 20px rgba(123,47,190,.4)';
}

function enterDungeon(){
  if(!mintedHero || !selDungeon || combat.running) return;
  if(selDungeon.entry > 0){
    if(flg < selDungeon.entry) return;
    saveFLG(flg - selDungeon.entry);
    hudVals.burned += selDungeon.entry;
  }
  const box = document.getElementById('logBox');
  box.innerHTML = '';
  hideEvent();
  selDungeon.intro.forEach((log, i) => {
    setTimeout(() => addLog(log, '#8a8aaa'), i * 600);
  });
  setTimeout(() => startCombat(), selDungeon.intro.length * 600 + 300);
}

