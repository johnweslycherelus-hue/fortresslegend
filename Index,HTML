<style>
:root{
  --purple:#7B2FBE;
  --purple-text:#9B5FDE;
  --purple2:#4A1280;
  --gold:#C9A22A;
  --gold2:#F0C84A;
  --gold-dim:#8B6F1A;
  --dark:#06040F;
  --dark2:#0D0820;
  --dark3:#160D2E;
  --green:#1A9A6B;
  --red:#C0392B;
  --blue:#2980B9;
  --text:#E8DDF5;
  --muted:#8A7AAA;
  --border:rgba(123,47,190,0.25);
  --border-gold:rgba(201,162,42,0.3);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--dark);color:var(--text);font-family:'Crimson Text',Georgia,serif;font-size:18px;line-height:1.7;overflow-x:hidden;}
#canvas{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.5;}
.bg-glow{position:fixed;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(123,47,190,.18) 0%,transparent 60%),radial-gradient(ellipse 50% 40% at 80% 80%,rgba(26,154,107,.05) 0%,transparent 50%);pointer-events:none;z-index:0;}

/* ═══ NAV ═══ */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:rgba(6,4,15,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(–border);}
.nav-logo{font-family:‘Cinzel’,serif;font-weight:900;font-size:16px;letter-spacing:.12em;background:linear-gradient(135deg,var(–gold),#fff8e0,var(–gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.nav-links{display:flex;gap:28px;list-style:none;}
.nav-links a{font-family:‘Share Tech Mono’,monospace;font-size:11px;letter-spacing:.15em;color:var(–muted);text-decoration:none;transition:color .2s;}
.nav-links a:hover{color:var(–gold);}
.nav-cta{font-family:‘Cinzel’,serif;font-size:11px;font-weight:700;letter-spacing:.1em;color:var(–dark);background:linear-gradient(135deg,var(–gold2),var(–gold));border:none;padding:9px 20px;border-radius:4px;cursor:pointer;text-decoration:none;transition:all .2s;}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(201,162,42,.3);}
.nav-burger{display:none;background:transparent;border:1px solid var(–border);color:var(–text);padding:8px 12px;cursor:pointer;font-family:‘Share Tech Mono’,monospace;font-size:12px;border-radius:3px;}

.wrap{position:relative;z-index:2;}
section{padding:100px 24px;position:relative;}
.inner{max-width:1100px;margin:0 auto;}
.section-tag{font-family:‘Share Tech Mono’,monospace;font-size:11px;letter-spacing:.3em;color:var(–purple-text);margin-bottom:16px;display:block;}
.section-title{font-family:‘Cinzel’,serif;font-size:clamp(26px,3.5vw,42px);font-weight:700;color:#F0E8FF;margin-bottom:16px;line-height:1.15;}
.section-title span{color:var(–gold);}
.section-lead{font-size:18px;color:var(–muted);max-width:680px;line-height:1.75;margin-bottom:52px;}

/* ═══ HERO ═══ */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:130px 24px 80px;position:relative;}
.hero-eyebrow{font-family:‘Share Tech Mono’,monospace;font-size:11px;letter-spacing:.35em;color:var(–purple-text);margin-bottom:20px;opacity:0;animation:fadeUp .8s ease .2s forwards;}
.hero-title{font-family:‘Cinzel’,serif;font-weight:900;font-size:clamp(48px,9vw,108px);line-height:.95;letter-spacing:-.01em;background:linear-gradient(160deg,#fff8e0 0%,var(–gold2) 30%,var(–gold) 60%,#8B5A00 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:10px;opacity:0;animation:fadeUp .9s ease .4s forwards;}
.hero-sub{font-family:‘Cinzel’,serif;font-size:clamp(13px,2vw,20px);color:var(–purple-text);letter-spacing:.2em;margin-bottom:28px;opacity:0;animation:fadeUp .9s ease .6s forwards;}
.hero-desc{max-width:620px;font-size:18px;color:#B0A0CC;line-height:1.75;margin:0 auto 40px;opacity:0;animation:fadeUp .9s ease .8s forwards;}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;opacity:0;animation:fadeUp .9s ease 1s forwards;}
.btn-primary{font-family:‘Cinzel’,serif;font-size:13px;font-weight:700;letter-spacing:.1em;color:var(–dark);background:linear-gradient(135deg,var(–gold2),var(–gold));border:none;padding:15px 34px;border-radius:4px;cursor:pointer;text-decoration:none;transition:all .3s;box-shadow:0 0 28px rgba(201,162,42,.3);display:inline-block;}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 0 48px rgba(201,162,42,.5);}
.btn-secondary{font-family:‘Cinzel’,serif;font-size:13px;font-weight:600;letter-spacing:.1em;color:var(–gold);background:transparent;border:1px solid rgba(201,162,42,.4);padding:15px 34px;border-radius:4px;cursor:pointer;text-decoration:none;transition:all .3s;display:inline-block;}
.btn-secondary:hover{background:rgba(201,162,42,.08);border-color:var(–gold);transform:translateY(-2px);}

/* ═══ SCROLL HINT ═══ */
.scroll-hint{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:fadeUp 1s ease 1.6s forwards;}
.scroll-hint span{font-family:‘Share Tech Mono’,monospace;font-size:10px;letter-spacing:.2em;color:var(–muted);}
.scroll-line{width:1px;height:38px;background:linear-gradient(180deg,var(–gold),transparent);animation:scrollLine 2s ease-in-out infinite;}

/* ═══ STATS BAR ═══ */
.stats-bar{background:rgba(13,8,32,.95);border-top:1px solid var(–border);border-bottom:1px solid var(–border);padding:24px 48px;display:flex;justify-content:center;gap:0;flex-wrap:wrap;}
.stat-item{text-align:center;padding:10px 36px;border-right:1px solid var(–border);}
.stat-item:last-child{border-right:none;}
.stat-val{font-family:‘Cinzel’,serif;font-size:22px;font-weight:700;color:var(–gold);display:block;line-height:1;margin-bottom:5px;}
.stat-label{font-family:‘Share Tech Mono’,monospace;font-size:9px;letter-spacing:.18em;color:var(–muted);}

/* ═══ CARDS ═══ */
.card{background:linear-gradient(145deg,#0f0f20,#1a1030);border:1px solid var(–border);border-radius:10px;padding:28px;}
.card-sm{background:rgba(13,8,32,.8);border:1px solid var(–border);border-radius:8px;padding:20px;}
.card-title{font-family:‘Share Tech Mono’,monospace;font-size:10px;letter-spacing:.22em;color:var(–muted);margin-bottom:16px;}

/* ═══ HERO PORTRAITS (NEW) ═══ */
.heroes-section{padding:80px 24px;background:linear-gradient(180deg,var(–dark) 0%,var(–dark3) 50%,var(–dark) 100%);}
.heroes-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:40px;}
.hero-card{background:linear-gradient(155deg,rgba(22,13,46,.9),rgba(13,8,32,.95));border:1px solid var(–border);border-radius:10px;padding:0;overflow:hidden;transition:all .4s;position:relative;cursor:pointer;}
.hero-card::before{content:’’;position:absolute;top:0;left:0;right:0;height:3px;transition:opacity .4s;opacity:0;}
.hero-card:hover{transform:translateY(-6px);}
.hero-card:hover::before{opacity:1;}
.hero-card.warrior:hover{border-color:rgba(192,57,43,.6);box-shadow:0 12px 40px rgba(192,57,43,.25);}
.hero-card.warrior::before{background:linear-gradient(90deg,transparent,var(–red),transparent);}
.hero-card.mage:hover{border-color:rgba(142,68,173,.6);box-shadow:0 12px 40px rgba(142,68,173,.25);}
.hero-card.mage::before{background:linear-gradient(90deg,transparent,#8E44AD,transparent);}
.hero-card.rogue:hover{border-color:rgba(26,138,107,.6);box-shadow:0 12px 40px rgba(26,138,107,.25);}
.hero-card.rogue::before{background:linear-gradient(90deg,transparent,#1A8A6B,transparent);}
.hero-card.healer:hover{border-color:rgba(212,172,13,.6);box-shadow:0 12px 40px rgba(201,162,42,.25);}
.hero-card.healer::before{background:linear-gradient(90deg,transparent,var(–gold),transparent);}

.hero-portrait{position:relative;aspect-ratio:3/4;overflow:hidden;background:radial-gradient(ellipse at center top,rgba(123,47,190,.3),transparent 70%),linear-gradient(180deg,#0a0515,#050208);}
.hero-portrait svg{width:100%;height:100%;display:block;}
.hero-portrait .glow{position:absolute;inset:0;background:radial-gradient(circle at 50% 40%,var(–glow-color,rgba(201,162,42,.3)) 0%,transparent 60%);mix-blend-mode:screen;pointer-events:none;animation:glowPulse 4s ease-in-out infinite;}
.hero-portrait .rarity-ribbon{position:absolute;top:10px;right:-30px;transform:rotate(45deg);background:linear-gradient(90deg,var(–gold-dim),var(–gold));color:var(–dark);font-family:‘Share Tech Mono’,monospace;font-size:9px;font-weight:700;padding:4px 40px;letter-spacing:.18em;box-shadow:0 2px 8px rgba(0,0,0,.5);}
.hero-portrait .class-icon{position:absolute;top:10px;left:10px;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;font-size:18px;border:1px solid rgba(255,255,255,.1);}

.hero-info{padding:20px 18px;}
.hero-name{font-family:‘Cinzel’,serif;font-size:18px;font-weight:700;color:#E8D8FF;margin-bottom:4px;}
.hero-role{font-family:‘Share Tech Mono’,monospace;font-size:10px;letter-spacing:.14em;margin-bottom:14px;}
.hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;margin-bottom:14px;}
.hero-stat{display:flex;justify-content:space-between;font-family:‘Share Tech Mono’,monospace;font-size:10px;}
.hero-stat-label{color:var(–muted);letter-spacing:.1em;}
.hero-stat-val{color:var(–gold);font-weight:700;}
.hero-ultimate{padding:10px 12px;background:rgba(123,47,190,.08);border:1px solid rgba(123,47,190,.2);border-radius:5px;margin-top:10px;}
.hero-ultimate-label{font-family:‘Share Tech Mono’,monospace;font-size:9px;letter-spacing:.18em;color:var(–purple-text);margin-bottom:4px;}
.hero-ultimate-name{font-family:‘Cinzel’,serif;font-size:13px;font-weight:600;color:var(–text);}
.hero-ultimate-desc{font-size:12px;color:var(–muted);font-style:italic;line-height:1.4;margin-top:3px;}

/* ═══ LOOP GRID ═══ */
.loop-grid{display:flex;gap:0;align-items:center;flex-wrap:wrap;justify-content:center;}
.loop-step{text-align:center;padding:20px 16px;flex:1;min-width:130px;max-width:170px;}
.loop-icon{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 12px;border:2px solid;position:relative;}
.loop-icon::after{content:’’;position:absolute;inset:-4px;border-radius:50%;border:1px solid;opacity:.3;}
.loop-name{font-family:‘Cinzel’,serif;font-size:13px;font-weight:700;color:#E8D8FF;margin-bottom:4px;}
.loop-desc{font-size:12px;color:var(–muted);line-height:1.4;}
.loop-arrow{font-size:20px;color:var(–gold);opacity:.4;flex-shrink:0;padding:0 4px;}

/* ═══ FEATURES ═══ */
.feature-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;}
.feature-card{background:linear-gradient(145deg,rgba(22,13,46,.9),rgba(13,8,32,.95));border:1px solid var(–border);border-radius:8px;padding:32px 28px;transition:all .35s;position:relative;overflow:hidden;}
.feature-card::before{content:’’;position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(–gold),transparent);opacity:0;transition:opacity .35s;}
.feature-card:hover{border-color:rgba(201,162,42,.3);transform:translateY(-3px);}
.feature-card:hover::before{opacity:1;}
.feature-icon{font-size:34px;margin-bottom:18px;display:block;}
.feature-title{font-family:‘Cinzel’,serif;font-size:17px;font-weight:700;color:#F0E8FF;margin-bottom:10px;}
.feature-desc{font-size:16px;color:var(–muted);line-height:1.65;}
.tag{display:inline-block;font-family:‘Share Tech Mono’,monospace;font-size:10px;letter-spacing:.1em;color:var(–gold);background:rgba(201,162,42,.1);border:1px solid rgba(201,162,42,.25);border-radius:20px;padding:3px 10px;margin-top:14px;}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes livePulse{0%,100%{box-shadow:0 0 0 0 rgba(26,154,107,.4)}50%{box-shadow:0 0 0 6px rgba(26,154,107,0)}}
@keyframes scrollLine{0%,100%{transform:scaleY(1);opacity:1}50%{transform:scaleY(.6);opacity:.4}}
@keyframes glowPulse{0%,100%{opacity:.7}50%{opacity:1}}
</style>

</head>
